{
  "name": "ttrpg-soundboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backup": "powershell -Command \"git add .; git commit -m \"Backup: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')\"\"",
    "backup-feature": "powershell -Command \"git add .; git commit -m \"Feature backup: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') - %npm_config_message%\"\"",
    "status": "git status",
    "log": "git log --oneline -10",
    "restore-last": "git reset --hard HEAD~1"
  },
  "dependencies": {
    "lucide-react": "^0.428.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^8.2.0"
  }
}
